{
  "name": "codebloom",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/prepare-playground.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/prepare-playground.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:e2e": "npm run build && playwright test",
    "test:runner": "node --test scripts/check-examples.test.mjs",
    "test:unit": "node --import ./scripts/tsx-loader.mjs --test \"src/**/*.test.ts\"",
    "check:examples": "node scripts/check-examples.mjs",
    "verify:browser": "node scripts/verify-browser.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.61.0",
    "next": "^16.4.3",
    "pyodide": "314.0.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "0.0.1",
    "shiki": "4.5.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
